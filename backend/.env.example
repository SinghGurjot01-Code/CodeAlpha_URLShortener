# Copy to .env (backend/.env) for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# Public origin used to build short links (no trailing slash).
# REQUIRED in production, e.g. https://sho.example.com
BASE_URL=http://localhost:3000

# SQLite file path (relative paths resolve from backend/).
# REQUIRED in production - point it at persistent storage, e.g. /var/data/urls.db
DATABASE_PATH=./data/urls.db

# Comma-separated browser origins allowed to call the API when the frontend is hosted
# on a different origin (e.g. https://my-frontend.netlify.app). Leave empty for same-origin.
CORS_ORIGIN=

# Serve ../frontend from this server (true/false). Set false if the frontend is hosted elsewhere.
SERVE_FRONTEND=true

# Length of generated short codes (default 7).
SHORT_CODE_LENGTH=7

# Set to 1 when running behind a reverse proxy / PaaS load balancer.
TRUST_PROXY=
