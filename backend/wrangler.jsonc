{
  // Express on Cloudflare Workers + D1. Frontend is served as static assets from ../frontend.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codealpha-urlshortener",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  // Node.js APIs + node:http server support, required by Express.
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  // Static frontend. Files that match (/, /config.js) are served directly;
  // everything else (/api/*, /:code) falls through to the Worker.
  "assets": { "directory": "../frontend" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codealpha-urlshortener-db",
      // Real D1 database id (an identifier, not a secret).
      // Local development (`--local`) uses a separate local D1 under .wrangler/.
      "database_id": "be32112a-ab78-4cdc-98fe-f5fcc85489aa",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret configuration. No secrets are used by this app.
  "vars": {
    // Public origin for short links. In local dev, use .dev.vars or leave empty to derive from request.
    "BASE_URL": "https://ca-urls.vercel.app",
    // Comma-separated origins allowed to call the API from a separately hosted frontend.
    "CORS_ORIGIN": "https://ca-urls.vercel.app",
    "SHORT_CODE_LENGTH": "6"
  },

  "observability": { "enabled": true }
}


